# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Optional for local use; Render generates this value automatically
WEBHOOK_SECRET=

# Comma-separated list of admin Telegram IDs
ADMIN_IDS=123456789,987654321

# Database Connection URL
# Local default: sqlite+aiosqlite:///./database.db
# Railway production (with persistent volume mounted at /data): sqlite+aiosqlite:////data/database.db
DATABASE_URL=sqlite+aiosqlite:////data/database.db

# Debug mode (true/false)
DEBUG=false
